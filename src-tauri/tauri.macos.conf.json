{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VersionDock Desktop",
        "width": 880,
        "height": 540,
        "minWidth": 800,
        "minHeight": 480,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "backgroundColor": "#121314",
        "resizable": true,
        "center": true,
        "dragDropEnabled": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 18
        }
      }
    ]
  }
}
