{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VersionDock Desktop",
  "version": "0.1.0",
  "identifier": "com.versiondock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": " ",
        "width": 880,
        "height": 540,
        "minWidth": 800,
        "minHeight": 480,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Independent Git and SVN desktop workbench",
    "longDescription": "VersionDock Desktop is a compact independent Git and SVN workbench.",
    "copyright": "Copyright (C) 2026 chenqinru",
    "license": "GPL-3.0-only",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
