{
  "name": "versiondock-desktop",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "browser:dev": "vite --mode browser",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "tauri:build": "tauri build",
    "fixture:runtime": "node scripts/create-runtime-fixture.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run bindings:check && vite build",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings -- --nocapture",
    "bindings:check": "node scripts/check-bindings.mjs",
    "check:independence": "node scripts/check-independence.mjs",
    "check:window": "node scripts/check-window-config.mjs",
    "check": "npm run check:independence && npm run check:window && npm run typecheck && npm run lint && npm run test && npm run build && cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.24",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-os": "2.3.2",
    "@vscode/codicons": "0.0.46-24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shiki": "3.23.0",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20.19.33",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "7.3.1",
    "vitest": "^4.0.18"
  }
}
