{
  "name": "versiondock-desktop",
  "version": "0.1.5",
  "description": "Independent Git and SVN desktop workbench built with Tauri 2, Rust and React",
  "private": true,
  "license": "GPL-3.0-only",
  "author": {
    "name": "chenqinru",
    "url": "https://github.com/chenqinru"
  },
  "homepage": "https://github.com/chenqinru/VersionDockDesktop#readme",
  "bugs": {
    "url": "https://github.com/chenqinru/VersionDockDesktop/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chenqinru/VersionDockDesktop.git"
  },
  "keywords": [
    "git",
    "svn",
    "tauri",
    "rust",
    "react",
    "desktop",
    "vcs",
    "version-control",
    "source-control",
    "git-graph",
    "merge-editor",
    "changelist",
    "shelve",
    "stash"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "browser:dev": "vite --mode browser",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "tauri:build": "tauri build",
    "package:macos:dmg": "node scripts/package-macos-dmg.mjs",
    "fixture:runtime": "node scripts/create-runtime-fixture.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:release": "node --test scripts/release.test.mjs scripts/package-macos-dmg.test.mjs",
    "build": "npm run bindings:check && npm run build:frontend",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings -- --nocapture",
    "bindings:check": "node scripts/check-bindings.mjs",
    "check:metadata": "node scripts/check-version.mjs",
    "check:independence": "node scripts/check-independence.mjs",
    "check:window": "node scripts/check-window-config.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "check:frontend": "npm run check:frontend:source && npm run build",
    "check:rust": "cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "check": "npm run check:frontend && npm run check:rust",
    "build:frontend": "vite build",
    "check:frontend:ci": "npm run check:frontend:source && npm run build:frontend",
    "check:frontend:source": "npm run check:metadata && npm run check:independence && npm run check:window && npm run check:i18n && npm run typecheck && npm run lint && npm run test:release && npm run test"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.24",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-os": "2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vscode/codicons": "0.0.46-24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "shiki": "3.23.0",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^20.19.33",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "7.3.1",
    "vitest": "^4.0.18"
  }
}
